# 复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
#
# 云开发环境 ID：控制台顶部环境卡片可复制；同时记得改 cloudbaserc.json 的 envId
VITE_ENV_ID=your-env-id

# 客户端 Publishable Key：控制台 → 环境 → API 密钥
# 该 Key 会打包进前端，但请勿把生产环境的 Key 提交到公开仓库
VITE_PUBLISHABLE_KEY=your-publishable-key

# ---- 以下开关请写在 .env.development / .env.production，不要写在本文件 ----
# VITE_USE_MOCK    商品数据源：true = 本地 mock/products_02.json
# VITE_ORDER_MOCK  订单数据源：false = 云端 orders 集合
# VITE_PAY_MODE    支付模式：mock = 模拟支付（个人主体小程序）/ auto = 真实微信支付

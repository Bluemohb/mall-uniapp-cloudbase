{
  // 主包只保留 4 个 tabBar 页（微信要求 tabBar 页必须在主包），其余页面全部下沉到 subPackages。
  // 分包 root 直接沿用原目录（如 pages/order），root + path 拼出的完整路径与拆分前完全一致，
  // 所以业务代码里的 uni.navigateTo({ url: '/pages/order/order-list' }) 一个字都不用改。
  "pages": [ // pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/products/products",
      "style": {
        "navigationBarTitleText": "商品列表",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationBarTitleText": "购物车",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/profile/profile",
      "style": {
        "navigationBarTitleText": "用户信息",
        "navigationBarTextStyle": "white"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "CloudBase UniApp",
    // 换主题需同步此值：小程序原生配置只吃十六进制字面量，无法复用 uni.scss 变量
    "navigationBarBackgroundColor": "#667eea",
    "backgroundColor": "#f5f5f5"
  },
  "tabBar": {
    "color": "#999999",
    // 同上，与主题主色保持一致
    "selectedColor": "#667eea",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/products/products",
        "text": "商品",
        "iconPath": "static/tabbar/grid.png",
        "selectedIconPath": "static/tabbar/grid-active.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tabbar/cart.png",
        "selectedIconPath": "static/tabbar/cart-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
	  "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }

  },
  "subPackages": [
    {
      "root": "pages/search",
      "pages": [
        {
          "path": "search",
          "style": {
            "navigationBarTitleText": "搜索",
            "navigationBarTextStyle": "white",
            "onReachBottomDistance": 100
          }
        }
      ]
    },
    {
      "root": "pages/product-detail",
      "pages": [
        {
          "path": "product-detail",
          "style": {
            "navigationBarTitleText": "商品详情",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    },
    {
      "root": "pages/favorite",
      "pages": [
        {
          "path": "favorite",
          "style": {
            "navigationBarTitleText": "我的收藏",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    },
    {
      "root": "pages/order",
      "pages": [
        {
          "path": "order-confirm",
          "style": {
            "navigationBarTitleText": "确认订单",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "order-detail",
          "style": {
            "navigationBarTitleText": "订单详情",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "order-list",
          "style": {
            "navigationBarTitleText": "我的订单",
            "navigationBarTextStyle": "white",
            "enablePullDownRefresh": true
          }
        }
      ]
    },
    {
      "root": "pages/address",
      "pages": [
        {
          "path": "address-list",
          "style": {
            "navigationBarTitleText": "收货地址",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "address-form",
          "style": {
            "navigationBarTitleText": "编辑地址",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    },
    {
      "root": "pages/login",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "选择登录方式",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "password-login",
          "style": {
            "navigationBarTitleText": "密码登录",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "phone-login",
          "style": {
            "navigationBarTitleText": "手机验证码登录",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "email-login",
          "style": {
            "navigationBarTitleText": "邮箱验证码登录",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    },
    {
      "root": "pages/account",
      "pages": [
        {
          "path": "account-info",
          "style": {
            "navigationBarTitleText": "账号信息",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    }
  ],
  // 进入 tabBar 页时预下载接下来最可能用到的分包，避免首次点击时的加载等待
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages/search", "pages/product-detail"]
    },
    "pages/products/products": {
      "network": "all",
      "packages": ["pages/search", "pages/product-detail"]
    },
    "pages/cart/cart": {
      "network": "all",
      "packages": ["pages/product-detail", "pages/order"]
    },
    "pages/profile/profile": {
      "network": "all",
      "packages": ["pages/order", "pages/address", "pages/favorite", "pages/login", "pages/account"]
    }
  }
}

# 生产构建配置（pnpm build:*）—— Vite / uni-app 以 mode=production 加载本文件
#
# 全部关闭 Mock，走 CloudBase 云数据库。
#
# 注意：这两个变量必须「显式声明」而不是省略。未声明的 VITE_ 变量在构建期
# 拿不到值，开关会退化成运行时读取，无法被常量折叠，mock 数据与相关分支
# 就不会被摇树移除，会被打进线上包（本项目实测会多出一个 mock-*.js chunk）。
VITE_USE_MOCK=false
VITE_ORDER_MOCK=false

# 支付模式：mock = 强制模拟支付
# 个人主体小程序无法开通微信支付（需企业主体 + 认证），商户凭证配不上，
# 而客户端的「能不能调起支付」探测在个人号里全为真 —— 不显式声明就会给出
# 一个点了必然失败的「立即支付」按钮。详见 README「支付模式开关」。
VITE_PAY_MODE=mock
